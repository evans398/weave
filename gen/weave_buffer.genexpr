Param a_start(0, min=0);                    // selection start in buffer a, in ms (waveform~ 3rd outlet)
Param a_end(0, min=0);                      // selection end in buffer a, in ms (waveform~ 4th outlet)
Param b_start(0, min=0);                    // selection start in buffer b, in ms
Param b_end(0, min=0);                      // selection end in buffer b, in ms
Param a_zero_x(2, min=1, max=100);          // crossings A plays per turn (2 = one waveset)
Param b_zero_x(2, min=1, max=100);          // crossings B plays per turn
Param loop_on(0, min=0, max=1);             // 1 = both ranges loop until this goes back to 0 (stops at the next zero crossing)
Param trig(0, min=0, max=1);                // with loop_on at 0: a change from 0 to 1 plays both ranges once
Param smooth_ms(0, min=0, max=3);           // local smoothing around each A/B join, in ms (0 = off); delays the output by this much

Data rb(512);                               // the spliced signal, last 512 samples
Data jb(512);                               // 1 where a hand-off happened
Buffer srcA("a");                           // a buffer~ named a
Buffer srcB("b");                           // a buffer~ named b
History running(0), ploop(0), ptrig(0), cur(0), pol(1), pv(0), hpv(0), zcount(0), kA(0), kB(0), lp(0);
History s0A(0), e0A(0), okA(0), s0B(0), e0B(0), okB(0);   // snapped range of each source and whether it is usable
History pnA(0), pnB(0), offc(0);            // buffer lengths last seen, samples since loop_on went off
History psA(0), peA(0), psB(0), peB(0);     // selections last seen
History wp(0), dly(0);                      // smoothing: write position, delay in samples (set when a run starts)
History pend(0), q0A(0), q1A(0), qokA(0), q0B(0), q1B(0), qokB(0);   // a changed selection, snapped, waiting for the next hand-off

SCAN = 100000;                              // how far (in samples) to look for a crossing when snapping

chn = mc_channel - 1;                       // this instance's channel, counted from 0
chA = min(chn, channels(srcA) - 1);         // a mono buffer feeds every channel
chB = min(chn, channels(srcB) - 1);
nA = dim(srcA);
nB = dim(srcB);

// work on local copies of the state, and write them back at the end
vrun = running;
voffc = offc;
if (nA != pnA || nB != pnB) { vrun = 0; }   // a buffer was changed or reloaded: stop, so a stale range is never read
vcur = cur;
vpol = pol;
vpv = pv;
vhpv = hpv;
vz = zcount;
vkA = kA;
vkB = kB;
vlp = lp;
vs0A = s0A;
ve0A = e0A;
vokA = okA;
vs0B = s0B;
ve0B = e0B;
vokB = okB;
vpend = pend;
vD = dly;
vq0A = q0A;
vq1A = q1A;
vqokA = qokA;
vq0B = q0B;
vq1B = q1B;
vqokB = qokB;

// ---- start: loop_on going to 1 starts the loop; trig going to 1 plays the one-shot (only while loop_on is 0)
//      nothing starts while a run is still going. Both snap the ranges to zero crossings first.
//      While a loop runs, moving a selection snaps the new range at once, and it takes over at the next hand-off.
loopedge = (loop_on >= 1 && ploop < 1);
trigedge = (trig >= 1 && ptrig < 1 && loop_on < 1);
startnow = (vrun == 0 && (loopedge == 1 || trigedge == 1));
selchg = (a_start != psA || a_end != peA || b_start != psB || b_end != peB);
resnap = (vrun == 1 && vlp == 1 && selchg == 1);
if (startnow == 1 || resnap == 1) {
    if (startnow == 1) { vlp = (loopedge == 1) ? 1 : 0; }
    for (w = 0; w < 2; w += 1) {
        n = (w == 0) ? nA : nB;
        sel1 = round(mstosamps((w == 0) ? a_start : b_start));   // ms to samples (assumes the file rate equals Max's)
        sel2 = round(mstosamps((w == 0) ? a_end : b_end));

        // start: the nearest crossing (a tie keeps the earlier one)
        s = -1;
        for (m = 0; m < SCAN; m += 1) {
            i = sel1 - m;
            if (i >= 1 && i < n) {
                xi = (w == 0) ? peek(srcA, i, chA) : peek(srcB, i, chB);
                xp = (w == 0) ? peek(srcA, i - 1, chA) : peek(srcB, i - 1, chB);
                if ((xp < 0 && xi >= 0) || (xp >= 0 && xi < 0)) { s = i; break; }
            }
            i = sel1 + m;
            if (m > 0 && i >= 1 && i < n) {
                xi = (w == 0) ? peek(srcA, i, chA) : peek(srcB, i, chB);
                xp = (w == 0) ? peek(srcA, i - 1, chA) : peek(srcB, i - 1, chB);
                if ((xp < 0 && xi >= 0) || (xp >= 0 && xi < 0)) { s = i; break; }
            }
        }

        // end: the nearest crossing after the start that travels the same way as the start
        endpt = -1;
        if (s >= 0) {
            xs = (w == 0) ? peek(srcA, s, chA) : peek(srcB, s, chB);
            d0 = (xs >= 0) ? 1 : -1;
            for (m = 0; m < SCAN; m += 1) {
                i = sel2 - m;
                if (i > s && i < n) {
                    xi = (w == 0) ? peek(srcA, i, chA) : peek(srcB, i, chB);
                    xp = (w == 0) ? peek(srcA, i - 1, chA) : peek(srcB, i - 1, chB);
                    di = (xi >= 0) ? 1 : -1;
                    if (((xp < 0 && xi >= 0) || (xp >= 0 && xi < 0)) && di == d0) { endpt = i; break; }
                }
                i = sel2 + m;
                if (m > 0 && i > s && i < n) {
                    xi = (w == 0) ? peek(srcA, i, chA) : peek(srcB, i, chB);
                    xp = (w == 0) ? peek(srcA, i - 1, chA) : peek(srcB, i - 1, chB);
                    di = (xi >= 0) ? 1 : -1;
                    if (((xp < 0 && xi >= 0) || (xp >= 0 && xi < 0)) && di == d0) { endpt = i; break; }
                }
            }
        }

        if (w == 0) {
            vq0A = s;
            vq1A = endpt;
            vqokA = (s >= 0 && endpt >= 0) ? 1 : 0;
        } else {
            vq0B = s;
            vq1B = endpt;
            vqokB = (s >= 0 && endpt >= 0) ? 1 : 0;
        }
    }
    vpend = 1;
    if (startnow == 1) {
        vs0A = vq0A;
        ve0A = vq1A;
        vokA = vqokA;
        vs0B = vq0B;
        ve0B = vq1B;
        vokB = vqokB;
        vpend = 0;
        vkA = 0;
        vkB = 0;
        vz = 0;
        vhpv = 0;
        vpol = 1;
        vcur = (vokA == 1) ? 0 : 1;         // A goes first when it has a usable range
        vD = min(floor(mstosamps(smooth_ms)), 128);   // read only when a run starts
        vrun = (vokA == 1 || vokB == 1) ? 1 : 0;
    }
}

y = 0;
joined = 0;
if (vrun == 1) {
    s = vcur;
    L = (s == 0) ? (ve0A - vs0A) : (ve0B - vs0B);
    ks = (s == 0) ? vkA : vkB;
    base = (s == 0) ? vs0A : vs0B;
    exhausted = (vlp == 0 && ks >= L);      // the range is used up (reads the crossing sample after the end)
    idx = (vlp == 1) ? base + (ks % L) : base + ks;
    x = (s == 0) ? peek(srcA, idx, chA) : peek(srcB, idx, chB);

    zc = (vhpv == 1) && ((vpv < 0 && x >= 0) || (vpv >= 0 && x < 0));
    event = (zc == 1 || exhausted == 1);    // both are zero crossings of the output
    if (vlp == 1 && loop_on < 1) { voffc += 1; } else { voffc = 0; }
    if (voffc > 2000) { event = 1; }        // failsafe: no crossing within ~45 ms of switching off, stop anyway

    if (vlp == 1 && loop_on < 1 && event == 1) {
        vrun = 0;                           // loop switched off: stop on this crossing, silent from here
    } else {
        z = vz;
        cut = 0;
        if (zc == 1) {
            tz = (s == 0) ? a_zero_x : b_zero_x;     // the count is read only at a zero crossing
            z += 1;
            if (z >= tz) { cut = 1; }
        }
        if (exhausted == 1) { cut = 1; }

        if (cut == 1) {
            // a moved selection takes over here (only if both new ranges are usable); both sources start their new range
            if (vlp == 1 && vpend == 1 && vqokA == 1 && vqokB == 1) {
                vs0A = vq0A;
                ve0A = vq1A;
                vs0B = vq0B;
                ve0B = vq1B;
                vkA = 0;
                vkB = 0;
                vpend = 0;
            }
            // is the other source finished?
            od = 0;
            if (s == 0) {
                if (vokB == 0 || (vlp == 0 && vkB >= (ve0B - vs0B))) { od = 1; }
            } else {
                if (vokA == 0 || (vlp == 0 && vkA >= (ve0A - vs0A))) { od = 1; }
            }

            if (od == 1) {
                if (exhausted == 1) {
                    vrun = 0;               // both ranges are used up
                } else {
                    // the other source is finished: carry on with this one (the append)
                    y = vpol * x;
                    vpv = x;
                    vhpv = 1;
                    vz = 0;
                    if (s == 0) { vkA = ks + 1; } else { vkB = ks + 1; }
                }
            } else {
                // HAND OFF: the other source continues from where it stopped
                nld = vpol * ((x >= 0) ? 1 : -1);    // direction the output is travelling through zero
                o = 1 - s;
                ko = (o == 0) ? vkA : vkB;
                Lo = (o == 0) ? (ve0A - vs0A) : (ve0B - vs0B);
                bo = (o == 0) ? vs0A : vs0B;
                io = (vlp == 1) ? bo + (ko % Lo) : bo + ko;
                xo = (o == 0) ? peek(srcA, io, chA) : peek(srcB, io, chB);
                dO = (xo >= 0) ? 1 : -1;
                vpol = nld * dO;            // flip the new chunk if it starts the wrong way
                y = vpol * xo;
                vpv = xo;
                vhpv = 1;
                vz = 0;
                vcur = o;
                joined = 1;
                if (o == 0) { vkA = ko + 1; } else { vkB = ko + 1; }
            }
        } else {
            y = vpol * x;
            vpv = x;
            vhpv = 1;
            vz = z;
            if (s == 0) { vkA = ks + 1; } else { vkB = ks + 1; }
        }
    }
}

// ---- local smoothing at the joins: the output is delayed by vD samples, and around each join the signal is
//      averaged over a window that is widest at the join and shrinks to nothing vD samples away from it.
poke(rb, y, wp);
poke(jb, joined, wp);
ys = y;
if (vD > 0) {
    sidx = (wp - vD + 512) % 512;           // the sample being output now
    dn = vD;                                // distance to the nearest join (vD = none close enough)
    for (d = 0; d < vD; d += 1) {
        if (peek(jb, (sidx + d) % 512) > 0 || peek(jb, (sidx - d + 512) % 512) > 0) { dn = d; break; }
    }
    hh = vD - dn;                           // half-width of the averaging window
    acc = 0;
    for (kk = -hh; kk <= hh; kk += 1) { acc += peek(rb, (sidx + kk + 512) % 512); }
    ys = acc / (2 * hh + 1);
}
wp = (wp + 1) % 512;
dly = vD;

running = vrun;
cur = vcur;
pol = vpol;
pv = vpv;
hpv = vhpv;
zcount = vz;
kA = vkA;
kB = vkB;
lp = vlp;
s0A = vs0A;
e0A = ve0A;
okA = vokA;
s0B = vs0B;
e0B = ve0B;
okB = vokB;
offc = voffc;
pend = vpend;
q0A = vq0A;
q1A = vq1A;
qokA = vqokA;
q0B = vq0B;
q1B = vq1B;
qokB = vqokB;
psA = a_start;
peA = a_end;
psB = b_start;
peB = b_end;
pnA = nA;
pnB = nB;
ploop = loop_on;
ptrig = trig;

out1 = ys;
